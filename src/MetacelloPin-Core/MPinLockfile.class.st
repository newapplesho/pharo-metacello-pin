"
I am the result of locking a dependency tree: the locked entries, in load order
(dependencies first), plus warnings for what could not be locked.

I print myself as a Metacello script in two steps: lock every entry, then load every entry,
dependencies first. The script needs both steps. Metacello skips a locked project that is
not loaded yet when another project requires it, so the script loads the entries itself.
Without the lock, a later load that asks for another version stops with
`MetacelloConflictingProjectError`. Evaluate the script, then load the project as usual.
"
Class {
	#name : #MPinLockfile,
	#superclass : #Object,
	#instVars : [
		'entries',
		'warnings'
	],
	#category : #'MetacelloPin-Core'
}

{ #category : #'instance creation' }
MPinLockfile class >> entries: aCollection warnings: aWarningCollection [

	^ self new
		  setEntries: aCollection warnings: aWarningCollection;
		  yourself
]

{ #category : #accessing }
MPinLockfile >> entries [

	^ entries
]

{ #category : #accessing }
MPinLockfile >> entryNamed: aString [

	^ entries detect: [ :each | each name = aString ] ifNone: [ nil ]
]

{ #category : #printing }
MPinLockfile >> script [

	^ String streamContents: [ :stream |
			  stream
				  nextPutAll: '"Generated by metacello-pin. Do not edit by hand.';
				  lf;
				  nextPutAll: ' Evaluate this script, then load the project as usual."';
				  lf.
			  warnings do: [ :each |
					  stream
						  lf;
						  nextPutAll: (MPinOccurrence commentFor: 'WARNING: ' , each) ].
			  self print: #lock title: '1. Lock every baseline at its commit.' on: stream.
			  self print: #load title: '2. Load them, dependencies first.' on: stream ]
]

{ #category : #printing }
MPinLockfile >> print: aCommand title: aString on: aStream [

	aStream
		lf;
		lf;
		nextPutAll: (MPinOccurrence commentFor: aString);
		lf.
	entries do: [ :each |
			aStream lf.
			each print: aCommand on: aStream ]
]

{ #category : #private }
MPinLockfile >> setEntries: aCollection warnings: aWarningCollection [

	entries := aCollection.
	warnings := aWarningCollection
]

{ #category : #accessing }
MPinLockfile >> warnings [

	^ warnings
]

{ #category : #writing }
MPinLockfile >> writeTo: aFile [
	"Write my script to aFile. I write a temporary file next to aFile first and then move it
	over aFile, so a failed write never leaves a truncated or empty lock file."

	| temporary |
	temporary := aFile parent / (aFile basename , '.metacello-pin.tmp').
	temporary ensureDelete.
	temporary writeStreamDo: [ :stream | stream nextPutAll: self script ].
	aFile ensureDelete.
	temporary moveTo: aFile
]
